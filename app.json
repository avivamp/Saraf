{
  "expo": {
    "name": "Saraf",
    "slug": "saraf",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "saraf",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "splash": {
      "backgroundColor": "#0A0A0C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saraf.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C"
      },
      "package": "com.saraf.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
